{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Juice",
  "mainBinaryName": "claude-juice",
  "version": "0.1.0",
  "identifier": "com.obscuratea.claudejuice",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Claude Juice",
        "width": 340,
        "height": 340,
        "minWidth": 140,
        "minHeight": 140,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
